# Godot + C# + JetBrains Rider .gitignore

# Godot
.import/
.export/
*.import
.godot/
export_presets.cfg

# Mono / C# build folders
bin/
obj/
*.exe
*.dll
*.pdb
*.mdb

# Rider / JetBrains
.idea/
*.sln.iml

# Visual Studio
.vs/
*.user
*.userosscache
*.suo
*.cache

# OS files
.DS_Store
Thumbs.db

# Node / npm (in case frontend uses it)
node_modules/
dist/

